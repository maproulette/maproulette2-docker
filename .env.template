# Copy this file to `.env` at the repo root and fill in the values below.
# The same file is consumed by both the api and frontend Docker builds/runs:
#   - api container: loaded via `docker run --env-file .env` at runtime.
#   - frontend container: copied into the build context so Vite can inline
#     VITE_* values at build time.
#
# Fields marked CHANGE_ME must be updated before running ./deploy.sh.

# -----------------------------------------------------------------------------
# Backend (Fastify)
# -----------------------------------------------------------------------------
PORT=9000
NODE_ENV=production

# Connection string for the PostGIS database. When deploying the database via
# deploy.sh, this points at the linked `mr-postgis` container on the mrnet
# Docker network. Override if you are using an external database.
DATABASE_URL=postgres://mrdbuser:mrdbpass@mr-postgis:5432/mrdata

# Public origin the backend will advertise in OAuth callbacks and redirects.
# This should be the URL users actually hit in their browser (i.e. the
# frontend / nginx host), NOT the internal container hostname.
API_PUBLIC_ORIGIN=http://127.0.0.1:3000

# OSM OAuth 2.0 credentials. Register an application on the OSM server and
# set the callback URL to ${API_PUBLIC_ORIGIN}/auth/callback.
OSM_OAUTH_CLIENT_ID=CHANGE_ME
OSM_OAUTH_CLIENT_SECRET=CHANGE_ME
OSM_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/auth/callback
OSM_BASE_URL=https://master.apis.dev.openstreetmap.org

# -----------------------------------------------------------------------------
# Frontend (Vite) — inlined at build time
# -----------------------------------------------------------------------------
VITE_APP_NAME=MapRoulette
VITE_APP_DESCRIPTION=MapRoulette
VITE_API_BASE_URL=
VITE_MAP_ROULETTE_SERVER_WEBSOCKET_URL=ws://127.0.0.1:3000/ws
VITE_SERVER_OAUTH_URL=auth/authenticate
VITE_SERVER_API_KEY=
VITE_DISABLE_DEVTOOLS=true
